# Sanitized templates are checked in as appsettings.<env>.example.json.
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
*.pfx
*.key

# ---- Large local data ------------------------------------------------------
Data/scraped_data.backup.json
# DB snapshots & media bundles — share out-of-band (Drive/WeTransfer), never
# commit: they bloat history permanently and may carry sensitive data.
*.sql
bagisto_dump.sql
bagisto_dump.zip
storage.zip

