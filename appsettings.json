{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DOS": "Server=127.0.0.1;Port=3306;Database=DOS;User=root;Password=YOUR_DB_PASSWORD_HERE;CharSet=utf8mb4;SslMode=None;AllowPublicKeyRetrieval=True"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "DOSApi",
    "Audience": "DOSApp",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Firebase": {
    "ProjectId": "",
    "ServiceAccountPath": "",
    "StorageBucket": ""
  },
  "App": {
    "BaseUrl": "http://localhost:8000",
    "Locale": "en",
    "StorefrontKey": "YOUR_DOS_STOREFRONT_KEY_HERE"
  }
}
